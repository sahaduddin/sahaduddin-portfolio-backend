# Copy this file to .env and fill in your own credentials.
# Do not commit your .env file to GitHub.

PORT=8080
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=portfolio
DB_CONN_LIMIT=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
